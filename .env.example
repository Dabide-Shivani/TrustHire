# Pick ONE provider. Everything uses the OpenAI-compatible API.

# --- Option 1: Google Gemini (free key from Google AI Studio, no card) ---
LLM_API_KEY=your-gemini-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# (model names change often: copy a current Flash model name from AI Studio)

# --- Option 2: Groq (free tier) ---
# LLM_API_KEY=your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option 3: Ollama (fully local, free, offline) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

TRUSTHIRE_DB=trusthire.db
